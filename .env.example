# Google Gemini API Key for Server-Side Vision Inference
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
# IMPORTANT: This key is read exclusively by the backend server.
# NEVER prefix with VITE_ and NEVER expose this key to browser client bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server Port (defaults to 3001)
PORT=3001
